{
  "name": "slurm-panel",
  "version": "0.1.0",
  "private": true,
  "description": "An experiment dashboard for Slurm-backed gpuq queues with optional authenticated job cancellation",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.4.2 <13"
  },
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server/index.js",
    "dev": "node --watch --env-file-if-exists=.env src/server/index.js",
    "demo": "node --env-file-if-exists=.env src/server/index.js --demo",
    "test": "node --test tests/*.test.js",
    "test:browser": "node e2e/check-ui.js"
  },
  "devDependencies": {
    "playwright": "1.61.1"
  }
}
