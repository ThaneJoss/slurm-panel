# demo 使用虚构数据；gpuq 读取下方指定的既有队列数据库。
PANEL_MODE=demo
HOST=127.0.0.1
PORT=5013
PANEL_CLUSTER_NAME=SLURM
PANEL_TITLE=实验进度
REFRESH_INTERVAL_MS=5000

# gpuq 模式必填。使用绝对路径；此文件只给出通用部署示例。
# GPUQ_DATABASE=/srv/gpuq/state/queue.sqlite3

# 可选：由调度侧导出的 GPU JSON 快照，面板只读取该文件。
# GPU_METRICS_FILE=/srv/gpuq/metrics/gpus.json

# 可选；不配置则隐藏跳转链接并使用浏览器本地时区。
# SLURM_WEB_URL=https://slurm.example.com
# TZ=Asia/Shanghai

# 真实队列默认只读。启用取消操作时，填写操作令牌，并保证服务用户可运行 gpuq cancel。
ENABLE_JOB_CONTROL=0
# JOB_CONTROL_TOKEN=replace-with-your-operator-token
# GPUQ_COMMAND=/usr/local/bin/gpuq
# HTTPS 反向代理提供访问时填写页面的公开 origin（不含路径）。
# PANEL_PUBLIC_ORIGIN=https://panel.example.com
